generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  ownerId   String
  owner     users                @relation("OrganizationOwner", fields: [ownerId], references: [id])
  invites   OrganizationInvite[]
  members   OrganizationMember[]
  teams     Team[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           users        @relation("OrganizationMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Team {
  id             String        @id @default(cuid())
  name           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ownerId        String
  organizationId String?
  isPrivate      Boolean?      @default(false)
  allowAutoJoin  Boolean?      @default(true)
  notes          Note[]
  tasks          Task[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  owner          users         @relation("TeamOwner", fields: [ownerId], references: [id])
  invites        TeamInvite[]
  members        TeamMember[]
}

model TeamMember {
  id        String     @id @default(cuid())
  teamId    String
  userId    String
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      users      @relation("TeamMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Task {
  id        String    @id @default(cuid())
  title     String
  content   String?
  status    String    @default("pending")
  priority  String    @default("low")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  teamId    String?
  assignedTo String?  // ID of the user assigned to this task
  subTasks  SubTask[]
  team      Team?     @relation(fields: [teamId], references: [id])
  user      users     @relation(fields: [userId], references: [id])
  assignee  users?    @relation("AssignedTasks", fields: [assignedTo], references: [id])
}

model SubTask {
  id        String   @id @default(cuid())
  title     String
  content   String?
  status    String   @default("pending")
  taskId    String
  user_id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id])
  user      users    @relation(fields: [user_id], references: [id])
}

model accounts {
  id                  String  @id
  user_id             String
  type                String
  provider            String
  provider_account_id String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  users               users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
}

model sessions {
  id            String   @id
  session_token String   @unique
  user_id       String
  expires       DateTime
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model users {
  id                      String               @id
  name                    String?
  email                   String?              @unique
  email_verified          DateTime?
  image                   String?
  avatar_url              String?
  username                String?              @unique
  password                String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime
  active_team             String?
  authoredNotes           Note[]               @relation("NoteAuthor")
  notesAboutMe            Note[]               @relation("NoteSubject")
  ownedOrganizations      Organization[]       @relation("OrganizationOwner")
  organizationInvites     OrganizationInvite[] @relation("OrganizationInviteInviter")
  organizationMemberships OrganizationMember[] @relation("OrganizationMembers")
  subTasks                SubTask[]
  tasks                   Task[]
  assignedTasks           Task[]               @relation("AssignedTasks")
  ownedTeams              Team[]               @relation("TeamOwner")
  teamInvites             TeamInvite[]         @relation("TeamInviteInviter")
  teamMemberships         TeamMember[]         @relation("TeamMembers")
  settings                UserSettings?
  accounts                accounts[]
  sessions                sessions[]
}

model verificationtokens {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model TeamInvite {
  id        String   @id @default(cuid())
  email     String
  teamId    String
  invitedBy String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  expiry    DateTime
  inviter   users    @relation("TeamInviteInviter", fields: [invitedBy], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  invitedBy      String
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  expiry         DateTime
  inviter        users        @relation("OrganizationInviteInviter", fields: [invitedBy], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  subjectId String?
  teamId    String?
  author    users    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject   users?   @relation("NoteSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([subjectId])
  @@index([teamId])
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  theme                String   @default("system")
  compactMode          Boolean  @default(false)
  showAnimations       Boolean  @default(true)
  defaultView          String   @default("list")
  showRecentTasks      Boolean  @default(true)
  showTeamActivity     Boolean  @default(true)
  showQuickActions     Boolean  @default(true)
  tasksPerPage         Int      @default(10)
  showTotalTasksCard   Boolean  @default(true)
  showCompletedCard    Boolean  @default(true)
  showPendingCard      Boolean  @default(true)
  showHighPriorityCard Boolean  @default(true)
  showSubtasksCard     Boolean  @default(true)
  showProductivityCard Boolean  @default(true)
  emailNotifications   Boolean  @default(true)
  pushNotifications    Boolean  @default(false)
  taskReminders        Boolean  @default(true)
  weeklyDigest         Boolean  @default(false)
  autoSave             Boolean  @default(true)
  showCompletedTasks   Boolean  @default(false)
  allowCookies         Boolean  @default(true)
  allowCachedData      Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MemberRole {
  OWNER
  MANAGER
  MEMBER
  TEAM_LEAD
}
